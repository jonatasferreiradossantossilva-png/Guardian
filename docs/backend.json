{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system, with a specific profile.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity, from Firebase Auth."
        },
        "name": {
          "type": "string",
          "description": "Full name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address for login and communication.",
          "format": "email"
        },
        "cpf": {
          "type": "string",
          "description": "CPF do usuário."
        },
        "rg": {
          "type": "string",
          "description": "RG do usuário."
        },
        "profile": {
          "type": "string",
          "description": "User's role, determining permissions.",
          "enum": [
            "gestor",
            "motorista",
            "pai",
            "auxiliar"
          ]
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number."
        },
        "active": {
          "type": "boolean",
          "description": "Indicates if the user account is active."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of user creation.",
          "format": "date-time"
        },
        "street": {
          "type": "string",
          "description": "Nome da rua."
        },
        "number": {
          "type": "string",
          "description": "Número do imóvel."
        },
        "complement": {
          "type": "string",
          "description": "Complemento do endereço."
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro."
        },
        "city": {
          "type": "string",
          "description": "Cidade."
        },
        "state": {
          "type": "string",
          "description": "Estado (UF)."
        },
        "zipCode": {
          "type": "string",
          "description": "Código Postal (CEP)."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "profile",
        "active"
      ]
    },
    "School": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "School",
      "type": "object",
      "description": "Represents a school within the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the School entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the school."
        },
        "cnpj": {
          "type": "string",
          "description": "CNPJ da escola."
        },
        "latitude": {
          "type": "number",
          "description": "Latitude of the school."
        },
        "longitude": {
          "type": "number",
          "description": "Longitude of the school."
        },
        "street": {
          "type": "string",
          "description": "Nome da rua."
        },
        "number": {
          "type": "string",
          "description": "Número do imóvel."
        },
        "complement": {
          "type": "string",
          "description": "Complemento do endereço."
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro."
        },
        "city": {
          "type": "string",
          "description": "Cidade."
        },
        "state": {
          "type": "string",
          "description": "Estado (UF)."
        },
        "zipCode": {
          "type": "string",
          "description": "Código Postal (CEP)."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Parent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Parent",
      "type": "object",
      "description": "Represents a parent or guardian of a student.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Parent entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the User entity for login details."
        },
        "name": {
          "type": "string",
          "description": "Name of the parent."
        },
        "email": {
          "type": "string",
          "description": "Email address of the parent.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the parent."
        },
        "cpf": {
          "type": "string",
          "description": "CPF do responsável."
        },
        "rg": {
          "type": "string",
          "description": "RG do responsável."
        },
        "street": {
          "type": "string",
          "description": "Nome da rua."
        },
        "number": {
          "type": "string",
          "description": "Número do imóvel."
        },
        "complement": {
          "type": "string",
          "description": "Complemento do endereço."
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro."
        },
        "city": {
          "type": "string",
          "description": "Cidade."
        },
        "state": {
          "type": "string",
          "description": "Estado (UF)."
        },
        "zipCode": {
          "type": "string",
          "description": "Código Postal (CEP)."
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "email",
        "phone"
      ]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student in the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Student entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the student."
        },
        "schoolId": {
          "type": "string",
          "description": "Reference to School. (Relationship: School 1:N Student)"
        },
        "parentId": {
          "type": "string",
          "description": "Reference to Parent. (Relationship: Parent 1:N Student)"
        },
        "routeId": {
          "type": "string",
          "description": "Reference to Route. (Relationship: Route 1:N Student)"
        },
        "latitude": {
          "type": "number",
          "description": "Latitude of the student's home."
        },
        "longitude": {
          "type": "number",
          "description": "Longitude of the student's home."
        },
        "status": {
          "type": "string",
          "description": "The boarding status of the student.",
          "enum": [
            "aguardando",
            "a_bordo",
            "desembarcado",
            "ausente"
          ]
        },
        "shift": {
          "type": "string",
          "description": "The student's school shift.",
          "enum": [
            "manha",
            "tarde"
          ]
        },
        "street": {
          "type": "string",
          "description": "Nome da rua."
        },
        "number": {
          "type": "string",
          "description": "Número do imóvel."
        },
        "complement": {
          "type": "string",
          "description": "Complemento do endereço."
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro."
        },
        "city": {
          "type": "string",
          "description": "Cidade."
        },
        "state": {
          "type": "string",
          "description": "Estado (UF)."
        },
        "zipCode": {
          "type": "string",
          "description": "Código Postal (CEP)."
        },
        "monthlyFee": {
          "type": "number",
          "description": "The monthly transportation fee for the student."
        }
      },
      "required": [
        "id",
        "name",
        "schoolId",
        "parentId",
        "status",
        "shift"
      ]
    },
    "Driver": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Driver",
      "type": "object",
      "description": "Represents a driver of a vehicle.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Driver entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to the User entity for login details."
        },
        "name": {
          "type": "string",
          "description": "Name of the driver."
        },
        "cpf": {
          "type": "string",
          "description": "CPF do motorista."
        },
        "rg": {
          "type": "string",
          "description": "RG do motorista."
        },
        "cnh": {
          "type": "string",
          "description": "Número da CNH do motorista."
        },
        "cnhCategory": {
          "type": "string",
          "description": "Categoria da CNH (ex: B, D)."
        },
        "status": {
          "type": "string",
          "description": "Status of the driver (e.g., 'inativo', 'em_rota', 'pausa').",
          "enum": [
            "inativo",
            "em_rota",
            "pausa"
          ]
        },
        "vehicleId": {
          "type": "string",
          "description": "Reference to Vehicle. (Relationship: Vehicle 1:1 Driver)"
        },
        "street": {
          "type": "string",
          "description": "Nome da rua."
        },
        "number": {
          "type": "string",
          "description": "Número do imóvel."
        },
        "complement": {
          "type": "string",
          "description": "Complemento do endereço."
        },
        "neighborhood": {
          "type": "string",
          "description": "Bairro."
        },
        "city": {
          "type": "string",
          "description": "Cidade."
        },
        "state": {
          "type": "string",
          "description": "Estado (UF)."
        },
        "zipCode": {
          "type": "string",
          "description": "Código Postal (CEP)."
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "userId"
      ]
    },
    "Vehicle": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vehicle",
      "type": "object",
      "description": "Represents a vehicle in the fleet.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Vehicle entity."
        },
        "model": {
          "type": "string",
          "description": "Model of the vehicle."
        },
        "licensePlate": {
          "type": "string",
          "description": "License plate of the vehicle."
        },
        "capacity": {
          "type": "number",
          "description": "Maximum number of passengers."
        },
        "active": {
          "type": "boolean",
          "description": "Indicates if the vehicle is in operation."
        }
      },
      "required": [
        "id",
        "model",
        "licensePlate",
        "capacity",
        "active"
      ]
    },
    "Route": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Route",
      "type": "object",
      "description": "Represents a route for transporting students.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Route entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the route."
        },
        "driverId": {
          "type": "string",
          "description": "Reference to Driver. (Relationship: Driver 1:N Route)"
        },
        "assistantId": {
          "type": "string",
          "description": "Reference to Assistant (User ID)."
        },
        "studentIds": {
          "type": "array",
          "description": "Ordered references to Students for the route stops.",
          "items": {
            "type": "string"
          }
        },
        "shift": {
          "type": "string",
          "description": "The route's operating shift.",
          "enum": [
            "manha",
            "tarde"
          ]
        },
        "turnByTurnDirections": {
          "type": "array",
          "description": "A list of turn-by-turn navigation instructions for the route.",
          "items": {
            "type": "string"
          }
        },
        "lastOptimizedAt": {
          "type": "string",
          "description": "Timestamp of the last time the route was optimized by AI.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "driverId",
        "shift"
      ]
    },
    "Invoice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Invoice",
      "type": "object",
      "description": "Represents an invoice for a student's transportation services.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Invoice entity."
        },
        "studentId": {
          "type": "string",
          "description": "Reference to Student. (Relationship: Student 1:N Invoice)"
        },
        "parentUserId": {
          "type": "string",
          "description": "The auth UID of the parent responsible for this invoice."
        },
        "description": {
            "type": "string",
            "description": "Description of the invoice item (e.g., 'Mensalidade', 'Viagem Avulsa')."
        },
        "amount": {
          "type": "number",
          "description": "Amount due on the invoice."
        },
        "dueDate": {
          "type": "string",
          "description": "Due date for the invoice.",
          "format": "date"
        },
        "status": {
          "type": "string",
          "description": "Status of the invoice.",
          "enum": [
            "pending",
            "paid",
            "overdue",
            "pagamento_em_analise"
          ]
        }
      },
      "required": [
        "id",
        "studentId",
        "parentUserId",
        "description",
        "amount",
        "dueDate",
        "status"
      ]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "description": "Represents a message between users (parents, drivers, assistants, admins).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Message entity."
        },
        "senderId": {
          "type": "string",
          "description": "Identifier of the sender (user ID from Firebase Auth)."
        },
        "recipientId": {
          "type": "string",
          "description": "Identifier of the recipient (user ID from Firebase Auth)."
        },
        "text": {
          "type": "string",
          "description": "Text content of the message."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of when the message was sent.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "senderId",
        "recipientId",
        "text",
        "timestamp"
      ]
    },
    "PredefinedMessage": {
      "title": "Predefined Message",
      "type": "object",
      "description": "A template for quick messages.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "text": {
          "type": "string",
          "description": "The content of the message."
        },
        "for": {
          "type": "string",
          "description": "Who can use this message ('parent', 'driver', 'assistant', 'all').",
          "enum": ["parent", "driver", "auxiliar", "all"]
        }
      },
      "required": ["id", "text", "for"]
    },
    "AuthorizedPickup": {
      "title": "Authorized Pickup",
      "type": "object",
      "description": "Represents a person authorized to pick up a student.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the authorized person."
        },
        "studentId": {
          "type": "string",
          "description": "The ID of the student this person is authorized for."
        },
        "parentUserId": {
          "type": "string",
          "description": "The auth UID of the parent who owns this record."
        },
        "name": {
          "type": "string",
          "description": "Full name of the authorized person."
        },
        "cpf": {
          "type": "string",
          "description": "CPF of the authorized person."
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number of the authorized person."
        }
      },
      "required": [
        "id",
        "studentId",
        "parentUserId",
        "name",
        "cpf"
      ]
    },
    "TripRequest": {
      "title": "Trip Request",
      "type": "object",
      "description": "Represents a request from a parent for a one-off trip for a student.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the trip request."
        },
        "studentId": {
          "type": "string",
          "description": "The ID of the student for this request."
        },
        "parentUserId": {
          "type": "string",
          "description": "The auth UID of the parent who made the request."
        },
        "schoolId": {
          "type": "string",
          "description": "Reference to the School entity for the trip's destination."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The specific date for the requested trip."
        },
        "type": {
          "type": "string",
          "description": "The type of trip.",
          "enum": [
            "ida",
            "volta",
            "ida_e_volta"
          ]
        },
        "shift": {
          "type": "string",
          "description": "The shift for the requested trip.",
          "enum": [
            "manha",
            "tarde"
          ]
        },
        "status": {
          "type": "string",
          "description": "The current status of the request.",
          "enum": [
            "pendente",
            "aprovada",
            "rejeitada",
            "aguardando_aprovacao_pai"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Optional reason or notes for the request."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the request was created."
        },
        "amount": {
          "type": "number",
          "description": "The cost of the trip, to be approved by the parent."
        }
      },
      "required": [
        "id",
        "studentId",
        "parentUserId",
        "date",
        "type",
        "shift",
        "status",
        "schoolId"
      ]
    },
    "Stop": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Stop",
      "type": "object",
      "description": "Represents a stop along a route",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Stop entity."
        },
        "address": {
          "type": "string",
          "description": "Address of the stop."
        },
        "latitude": {
          "type": "number",
          "description": "Latitude of the stop."
        },
        "longitude": {
          "type": "number",
          "description": "Longitude of the stop."
        }
      },
      "required": [
        "id",
        "address",
        "latitude",
        "longitude"
      ]
    },
    "LocationUpdate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location Update",
      "type": "object",
      "description": "Represents a real-time location update for a driver.",
      "properties": {
        "latitude": {
          "type": "number",
          "description": "The driver's current latitude."
        },
        "longitude": {
          "type": "number",
          "description": "The driver's current longitude."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the location update.",
          "format": "date-time"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "timestamp"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/schools/{schoolId}",
        "definition": {
          "entityName": "School",
          "schema": {
            "$ref": "#/backend/entities/School"
          },
          "description": "Stores information about schools.  Managers have full CRUD access.",
          "params": [
            {
              "name": "schoolId",
              "description": "The unique identifier for the school."
            }
          ]
        }
      },
      {
        "path": "/parents/{parentId}",
        "definition": {
          "entityName": "Parent",
          "schema": {
            "$ref": "#/backend/entities/Parent"
          },
          "description": "Stores information about parents. Managers have full CRUD access.",
          "params": [
            {
              "name": "parentId",
              "description": "The unique identifier for the parent."
            }
          ]
        }
      },
      {
        "path": "/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": {
            "$ref": "#/backend/entities/Student"
          },
          "description": "Stores information about students. Managers have full CRUD access.",
          "params": [
            {
              "name": "studentId",
              "description": "The unique identifier for the student."
            }
          ]
        }
      },
      {
        "path": "/drivers/{driverId}",
        "definition": {
          "entityName": "Driver",
          "schema": {
            "$ref": "#/backend/entities/Driver"
          },
          "description": "Stores information about drivers. Managers have full CRUD access.",
          "params": [
            {
              "name": "driverId",
              "description": "The unique identifier for the driver."
            }
          ]
        }
      },
      {
        "path": "/vehicles/{vehicleId}",
        "definition": {
          "entityName": "Vehicle",
          "schema": {
            "$ref": "#/backend/entities/Vehicle"
          },
          "description": "Stores information about vehicles. Managers have full CRUD access.",
          "params": [
            {
              "name": "vehicleId",
              "description": "The unique identifier for the vehicle."
            }
          ]
        }
      },
      {
        "path": "/routes/{routeId}",
        "definition": {
          "entityName": "Route",
          "schema": {
            "$ref": "#/backend/entities/Route"
          },
          "description": "Stores information about routes. Managers have full CRUD access.",
          "params": [
            {
              "name": "routeId",
              "description": "The unique identifier for the route."
            }
          ]
        }
      },
      {
        "path": "/invoices/{invoiceId}",
        "definition": {
          "entityName": "Invoice",
          "schema": {
            "$ref": "#/backend/entities/Invoice"
          },
          "description": "Stores invoice data. Rules enforce parent/admin access.",
          "params": [
            {
              "name": "invoiceId",
              "description": "The unique identifier for the invoice."
            }
          ]
        }
      },
      {
        "path": "/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "schema": {
            "$ref": "#/backend/entities/Message"
          },
          "description": "Stores all messages. Rules must enforce that users can only read messages where they are the sender or recipient.",
          "params": [
             {
              "name": "messageId",
              "description": "The unique identifier for the message."
            }
          ]
        }
      },
       {
        "path": "/predefined_messages/{messageId}",
        "definition": {
          "entityName": "PredefinedMessage",
          "schema": {
            "$ref": "#/backend/entities/PredefinedMessage"
          },
          "description": "Stores predefined messages for quick use.",
          "params": [
            {
              "name": "messageId",
              "description": "The unique identifier for the predefined message."
            }
          ]
        }
      },
      {
        "path": "/stops/{stopId}",
        "definition": {
          "entityName": "Stop",
          "schema": {
            "$ref": "#/backend/entities/Stop"
          },
          "description": "Stores information about stops. Managers have full CRUD access.",
          "params": [
            {
              "name": "stopId",
              "description": "The unique identifier for the stop."
            }
          ]
        }
      },
      {
        "path": "/locations/{driverId}",
        "definition": {
          "entityName": "LocationUpdate",
          "schema": {
            "$ref": "#/backend/entities/LocationUpdate"
          },
          "description": "Stores real-time location updates for drivers. Parents and Admins can read. Only the respective driver can write.",
          "params": [
            {
              "name": "driverId",
              "description": "The unique identifier for the driver."
            }
          ]
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
