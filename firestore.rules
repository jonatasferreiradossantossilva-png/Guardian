/**
 * Core Philosophy: This ruleset enforces a strict Role-Based Access Control (RBAC) model.
 * A user's administrative or driver privileges are determined by the existence of a corresponding
 * document in the `/roles_admin` or `/roles_driver` collections. Admins have full CRUD access
 * over all core data. Drivers have specific, limited write access, such as updating a student's status.
 *
 * Data Structure:
 * - /roles_admin/{userId}: Grants admin rights.
 * - /roles_driver/{userId}: Grants driver rights.
 * - Top-level collections (e.g., /schools, /students): Master data for the operation.
 * - /users/{userId}/messages/{messageId}: User-specific private data.
 *
 * Key Security Decisions:
 * - Admin-Only Master Data Management: All top-level collections are primarily managed by admins
 *   to centralize data control.
 * - Limited Driver Writes: Drivers are granted permission only to modify specific fields necessary
 *   for their tasks, like updating a student's boarding status. This is enforced using
 *   `request.resource.data.diff()`.
 * - User Data Ownership: The `/users/{userId}` path is strictly owned by the user, with
 *   admins also granted access for support.
 *
 * Denormalization for Authorization:
 * Role-based access is the primary mechanism, using `/roles_admin` and `/roles_driver`
 * as lookups. This is efficient and avoids embedding roles in every document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for readable, reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user is an administrator.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    /**
     * Checks if the currently authenticated user is a driver.
     */
    function isDriver() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_driver/$(request.auth.uid));
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Manages documents for schools in the system.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /schools/{schoolId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for parents/guardians.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /parents/{parentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for students.
     * @principle Allows reads for signed-in users. Admins have full write access.
     * Drivers are only allowed to update the 'status' field of a student, which is essential
     * for tracking boarding and disembarking.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if (isAdmin() && resource != null) || 
                     (isDriver() && resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for drivers.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for vehicles in the fleet.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /vehicles/{vehicleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages transportation route documents.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /routes/{routeId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages invoice documents for billing.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /invoices/{invoiceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages route stop documents.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /stops/{stopId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
    
    /**
     * @description Stores real-time location updates for drivers.
     * @principle Allows reads for any signed-in user for tracking, but writes are restricted
     * to the specific driver to ensure data integrity.
     */
    match /locations/{driverId} {
      allow get: if isSignedIn();
      allow update, create: if isDriver() && request.auth.uid == driverId;
    }

    /**
     * @description Stores messages partitioned by user.
     * @principle Restricts access to a user's own data tree, with an override for admins.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && request.resource.data.senderId == request.auth.uid;
      allow update: if (isOwner(resource.data.senderId) || isAdmin()) && resource != null;
      allow delete: if (isOwner(resource.data.senderId) || isAdmin()) && resource != null;
    }

    /**
     * @description Manages administrator roles.
     * @principle Secures role management by restricting modifications to existing admins and preventing discovery.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
    
    /**
     * @description Manages driver roles.
     * @principle Secures role management by restricting modifications to existing admins and preventing discovery.
     */
    match /roles_driver/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}
