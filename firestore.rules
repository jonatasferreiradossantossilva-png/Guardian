/**
 * Core Philosophy: This ruleset enforces a strict Role-Based Access Control (RBAC) model.
 * A user's administrative, driver, or monitor privileges are determined by the existence of a corresponding
 * document in the `/roles_admin`, `/roles_driver`, or `/roles_monitor` collections. Admins have full CRUD access
 * over all core data. Drivers and Monitors have specific, limited write access, such as updating a student's status.
 *
 * Data Structure:
 * - /roles_admin/{userId}: Grants admin rights.
 * - /roles_driver/{userId}: Grants driver rights.
 * - /roles_monitor/{userId}: Grants monitor rights.
 * - Top-level collections (e.g., /schools, /students): Master data for the operation.
 * - /messages/{messageId}: Communication channel between users.
 *
 * Key Security Decisions:
 * - Read Access for Authenticated Users: Most master data is readable by any signed-in user to support
 *   the functionality of different roles (parents seeing school info, drivers seeing student lists).
 * - Admin-Only Master Data Management: Write access (create, full update, delete) on top-level collections
 *   is centralized to administrators.
 * - Limited Task-Based Writes: Drivers and Monitors are granted permission only to modify specific fields
 *   necessary for their tasks, like updating a student's boarding status. This is enforced using
 *   `request.resource.data.diff()`.
 * - User Data Ownership: The `/users/{userId}` path is strictly owned by the user, with
 *   admins also granted access for support.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for readable, reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user is an administrator.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    /**
     * Checks if the currently authenticated user is a driver.
     */
    function isDriver() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_driver/$(request.auth.uid));
    }

    /**
     * Checks if the currently authenticated user is a monitor.
     */
    function isMonitor() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_monitor/$(request.auth.uid));
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Manages documents for schools in the system.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /schools/{schoolId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for parents/guardians.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /parents/{parentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for students.
     * @principle Allows reads for signed-in users. Admins have full write access.
     * Drivers and Monitors are only allowed to update the 'status' field, which is essential
     * for tracking boarding and disembarking.
     */
    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if (isAdmin() && resource != null) || 
                     ((isDriver() || isMonitor()) && resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for drivers.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for vehicles in the fleet.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /vehicles/{vehicleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages transportation route documents.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /routes/{routeId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages invoice documents for billing.
     * @principle Admins have full access. Parents can only read invoices linked to them.
     */
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.parentUserId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    /**
     * @description Manages business expenses.
     * @principle Only administrators can create, read, update, or delete expenses.
     */
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Manages route stop documents.
     * @principle Allows reads for signed-in users, centralizes control of writes to trusted administrators.
     */
    match /stops/{stopId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
    
    /**
     * @description Stores real-time location updates for drivers.
     * @principle Allows reads for any signed-in user for tracking, but writes are restricted
     * to the specific driver to ensure data integrity.
     */
    match /locations/{driverId} {
      allow get: if isSignedIn();
      allow update, create: if isDriver() && request.auth.uid == driverId;
    }

    /**
     * @description Manages all messages.
     * @principle Users can create messages. They can only read messages where they are the sender or recipient.
     */
    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      // No updates or deletes allowed to preserve chat history
      allow update, delete: if false;
    }
    
    /**
     * @description Stores predefined messages for quick use.
     * @principle All signed-in users can read, only admins can manage them.
     */
    match /predefined_messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
    }


    /**
     * @description Manages administrator roles.
     * @principle Secures role management by restricting modifications to existing admins and preventing discovery.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
    
    /**
     * @description Manages driver roles.
     * @principle Secures role management by restricting modifications to existing admins and preventing discovery.
     */
    match /roles_driver/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages monitor roles.
     * @principle Secures role management by restricting modifications to existing admins and preventing discovery.
     */
    match /roles_monitor/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages authorized pickup contacts for students.
     * @principle A parent can manage the contacts for their own child. This is enforced by
     * checking that the `parentUserId` in the document matches the authenticated user's UID.
     * A query on this collection must include `where('parentUserId', '==', request.auth.uid)`
     * to be secure and comply with these rules.
     */
    match /authorized_pickups/{pickupId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.parentUserId;
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.parentUserId;
    }

    /**
     * @description Manages one-off trip requests from parents.
     * @principle A parent can create and view requests for their child. Admins have full access.
     */
    match /trip_requests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.parentUserId == request.auth.uid;
      allow read, update: if isSignedIn() && resource.data.parentUserId == request.auth.uid;
      // Admins get full CRUD access for management
      allow read, write: if isAdmin();
    }
  }
}

    