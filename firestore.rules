/**
 * Core Philosophy: This ruleset enforces a strict Role-Based Access Control (RBAC) model.
 * A user's administrative privileges are determined by the existence of a corresponding
 * document in the `/roles_admin` collection. These "admins" or "managers" have full
 * CRUD (Create, Read, Update, Delete) access over all core operational data collections
 * like schools, students, drivers, and invoices. Data that is specific to a user, such
 * as private messages, is stored in a user-owned subcollection and is accessible only
 * by that user or an admin.
 *
 * Data Structure:
 * - /roles_admin/{userId}: A collection where document existence grants admin rights.
 * - Top-level collections (e.g., /schools, /students, /routes): Contain master data for
 *   the entire operation, managed exclusively by admins.
 * - /users/{userId}/messages/{messageId}: A nested structure for user-specific data,
 *   ensuring private data is partitioned by user.
 *
 * Key Security Decisions:
 * - Admin-Only Master Data: All top-level collections containing operational data are
 *   restricted to users with the 'admin' role. This centralizes data management and
 *   prevents unauthorized access or modification by other user types (e.g., parents, drivers).
 * - User Data Ownership: The `/users/{userId}` path tree is strictly owned by the user
 *   identified by `userId`, with admins also granted access for management and support.
 * - No Public Listings: Listing documents in any collection is restricted. Admin collections
 *   cannot be listed at all to prevent enumeration of privileged users. Other collections
 *   require admin or owner authentication.
 *
 * Denormalization for Authorization:
 * The primary authorization mechanism is role-based, using the `/roles_admin` collection
 * as a lookup. This is efficient and avoids embedding role information in every document.
 * For messages, the `senderId` is denormalized onto the message document itself. This
 * allows rules to verify that a user is not sending a message on behalf of someone else,
 * which is a critical authorization check that doesn't require extra document reads.
 *
 * Structural Segregation:
 * Admin role data (`/roles_admin`) is stored in a separate, dedicated collection. This
 * is more secure and performant than mixing role flags into a general `/users` collection,
 * as it prevents non-admins from even querying for role information and simplifies the
 * security rules for master data collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for readable, reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user is an administrator.
     * Admin status is granted by the existence of a document in the /roles_admin collection
     * with an ID matching the user's UID. This is a performant and secure way to manage roles.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the foundation for enforcing data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Manages documents for schools in the system.
     * @path /schools/{schoolId}
     * @allow An authenticated admin (create)s a new school document.
     * @deny A non-admin user attempts to (get) a school document.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /schools/{schoolId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for parents/guardians.
     * @path /parents/{parentId}
     * @allow An authenticated admin (update)s an existing parent document.
     * @deny A regular user attempts to (list) all parents.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /parents/{parentId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for students.
     * @path /students/{studentId}
     * @allow An authenticated admin (delete)s a student document.
     * @deny A non-admin user attempts to (create) a new student.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /students/{studentId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for drivers.
     * @path /drivers/{driverId}
     * @allow An authenticated admin (get)s a driver's status.
     * @deny Anonymous users attempting to (list) drivers.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /drivers/{driverId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages documents for vehicles in the fleet.
     * @path /vehicles/{vehicleId}
     * @allow An authenticated admin (create)s a new vehicle document.
     * @deny A non-admin user attempts to (update) a vehicle's license plate.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /vehicles/{vehicleId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages transportation route documents.
     * @path /routes/{routeId}
     * @allow An authenticated admin (update)s a route to add a new stop.
     * @deny A regular user attempts to (get) route information.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /routes/{routeId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages invoice documents for billing.
     * @path /invoices/{invoiceId}
     * @allow An authenticated admin (update)s an invoice status to 'paid'.
     * @deny A parent user attempts to (list) all invoices in the system.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /invoices/{invoiceId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages route stop documents.
     * @path /stops/{stopId}
     * @allow An authenticated admin (create)s a new stop document.
     * @deny A non-admin user attempts to (delete) a stop.
     * @principle Centralizes control of core business data to trusted administrators.
     */
    match /stops/{stopId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Stores messages partitioned by user. Allows a user to access their
     * own messages and admins to access any user's messages for support.
     * @path /users/{userId}/messages/{messageId}
     * @allow A user with uid=`userId` (create)s a new message in their own subcollection.
     * @deny A user with uid=`user_abc` attempts to (list) messages in `/users/user_xyz/messages`.
     * @principle Restricts access to a user's own data tree, with an override for admins.
     * Validates relational integrity by ensuring the sender ID on new messages matches the creator.
     */
    match /users/{userId}/messages/{messageId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && request.resource.data.senderId == request.auth.uid;
      allow update: if (isOwner(resource.data.senderId) || isAdmin()) && resource != null;
      allow delete: if (isOwner(resource.data.senderId) || isAdmin()) && resource != null;
    }

    /**
     * @description Manages administrator roles. The existence of a document grants
     * a user admin privileges across the application.
     * @path /roles_admin/{userId}
     * @allow An existing admin (create)s a document to grant another user admin rights.
     * @deny Any user, including an admin, attempts to (list) all admin documents to prevent enumeration.
     * @principle Secures role management by restricting modifications to existing admins and preventing discovery of privileged users.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}